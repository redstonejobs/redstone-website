# Public variables required by the browser and by the Cloudflare build.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=https://redstone.co.ke

# Server-only secrets. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=

# Server-side email configuration.
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=Red Stone Employment Agency
RESEND_REPLY_TO=
HR_SUPPORT_EMAIL=

# Keep real production values in Cloudflare/Supabase secret stores, not in Git.
