NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase administration. Never expose this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Automatic external job ingestion endpoint authentication.
# Use a long random value and configure the same value in the scheduler secret.
JOB_IMPORT_SECRET=

# FoundRole integration.
# The official remote MCP endpoint uses OAuth. For unattended production imports,
# use an approved partner/server feed when available, or a production-compatible
# OAuth access token/session supplied for server use. The ChatGPT plugin login is
# not automatically available to this website runtime.
FOUNDROLE_MCP_URL=https://www.foundrole.com/mcp
FOUNDROLE_MCP_PROTOCOL_VERSION=2025-06-18
FOUNDROLE_MCP_ACCESS_TOKEN=
FOUNDROLE_FEED_URL=
FOUNDROLE_FEED_TOKEN=

# Canada Job Bank integration.
# Do not point this at normal Job Bank search pages. Configure only the official
# XML feed URL issued to Red Stone after Job Bank approves feed access.
JOBBANK_XML_FEED_URL=
JOBBANK_XML_FEED_TOKEN=
